# ╔════════════════════════════════════════════════════════════════════════════╗
# ║                     DIANA V2 - Environment Template                        ║
# ║                                                                            ║
# ║  Copy this file to .env and fill in your values.                          ║
# ║  Or just run: bash scripts/dev/setup-admin.sh (auto-generates everything) ║
# ╚════════════════════════════════════════════════════════════════════════════╝

# ─────────────────────────────────────────────────────────────
# Backend Configuration (Go/Gin)
# ─────────────────────────────────────────────────────────────

# Server port
PORT=8080

# Environment: dev, staging, production
ENV=dev

# PostgreSQL connection string
# Local: postgres://user:pass@localhost:5432/diana?sslmode=disable
# Docker: postgres://diana:diana@localhost:5432/diana?sslmode=disable
DB_DSN=postgres://diana:diana@localhost:5432/diana?sslmode=disable

# JWT signing secret (REQUIRED - min 32 characters)
# Generate with: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_STRING

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:4000,http://localhost:5173

# ─────────────────────────────────────────────────────────────
# ML Server Configuration (Python/Flask)
# ─────────────────────────────────────────────────────────────

# ML server endpoint (empty = use mock predictor)
MODEL_URL=http://localhost:5001/predict

# ML server port
ML_PORT=5001

# Model version to use
MODEL_VERSION=binary_v2_no_bp

# Dataset hash for tracking
MODEL_DATASET_HASH=nhanes_postmenopausal_2011_2024

# ML request timeout (milliseconds)
MODEL_TIMEOUT_MS=2000

# ML API key for authentication (optional in dev, required in prod)
ML_API_KEY=dev-ml-api-key-12345

# ─────────────────────────────────────────────────────────────
# Docker Configuration (for docker-compose)
# ─────────────────────────────────────────────────────────────

# PostgreSQL credentials (used by docker-compose)
POSTGRES_USER=diana
POSTGRES_PASSWORD=diana
POSTGRES_DB=diana

# ─────────────────────────────────────────────────────────────
# Export Configuration
# ─────────────────────────────────────────────────────────────

# Maximum rows for CSV export
EXPORT_MAX_ROWS=5000

# ─────────────────────────────────────────────────────────────
# Demo Credentials (for quick testing after running setup-admin.sh)
# ─────────────────────────────────────────────────────────────

# These are auto-generated by setup-admin.sh
# DEMO_EMAIL=demo@diana.app
# DEMO_PASSWORD=DemoPass123!
