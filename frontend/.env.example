# Frontend Environment Configuration
# Copy this file to .env and adjust values as needed

# Backend API base URL (must include /api/v1)
VITE_API_BASE=http://localhost:8080/api/v1

# ML Server base URL
VITE_ML_BASE=http://localhost:5001
VITE_ML_PORT=5001

# ML API Key for authentication (required in production)
# Get this from your deployment or ML service provider
VITE_ML_API_KEY=your-secure-ml-api-key
