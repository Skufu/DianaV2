 PORT=8080
 ENV=dev
 DB_DSN=postgres://diana:diana@localhost:5432/diana?sslmode=disable
 JWT_SECRET=change-me-to-random-32-char-string-IMPORTANT
CORS_ORIGINS=http://localhost:3000
MODEL_URL=http://localhost:5001/predict
ML_PORT=5001
ML_API_KEY=change-me-in-production
# Model Version Options:
# - binary_v2_no_bp (Default: Primary At-Risk screening model, 12 features)
# - clinical_3class (3-class model: Normal vs Pre-diabetic vs Diabetic, 16 features)
MODEL_VERSION=binary_v2_no_bp
MODEL_DATASET_HASH=nhanes_postmenopausal_2011_2024
MODEL_TIMEOUT_MS=2000
EXPORT_MAX_ROWS=5000
DEMO_EMAIL=clinician@example.com
DEMO_PASSWORD=password123

# Frontend API Base Path. ML calls go through backend /api/v1/ml.
VITE_API_BASE=/api/v1

# Redis (optional - for caching)
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=
